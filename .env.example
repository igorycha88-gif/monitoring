# Шаблон секретов и настроек. Копировать в .env (chmod 600). .env НЕ коммитить!

LOG_LEVEL=INFO
LOG_FORMAT=json
SITES_CONFIG_PATH=config/sites.yml

# ЭПИК-1: uptime/SSL-коллекторы
UPTIME_INTERVAL_SECONDS=60
UPTIME_TIMEOUT_SECONDS=10.0
UPTIME_SUCCESS_MAX_CODE=399
SSL_INTERVAL_SECONDS=3600
SSL_TIMEOUT_SECONDS=10.0

# ЭПИК-2: коллектор Яндекс.Метрики (5 минут — см. ADR-003 §3)
METRIKA_INTERVAL_SECONDS=300
METRIKA_TIMEOUT_SECONDS=10.0

# ЭПИК-5: коллектор Яндекс.Вебмастера — ежедневно в часы WEBMASTER_CRON_HOUR
# (через запятую; вечерний прогон дозаполняет лаг агрегации Яндекса, ADR-008)
# по таймзоне WEBMASTER_CRON_TIMEZONE (host_id сайтов — в config/sites.yml)
WEBMASTER_CRON_HOUR=7,19
WEBMASTER_CRON_TIMEZONE=Europe/Moscow
WEBMASTER_TIMEOUT_SECONDS=10.0
WEBMASTER_TOP_QUERIES=50
# Окно дневной истории поиска для дашбордов ADR-008 (дней, 1..31)
WEBMASTER_HISTORY_DAYS=7
# Долговременное хранение данных Вебмастера в SQLite (ADR-009).
# Локально — файл в data/; в docker compose подставляется
# /var/lib/monitoring/webmaster.db (volume monitoring-db) автоматически.
# Пустая строка — хранение отключено.
WEBMASTER_DB_PATH=data/webmaster.db
# Рендер поисковых метрик из БД в /metrics (ADR-011): окно дневных точек
# (дней, граница кардинальности) и период фонового обновления кэша (сек)
WEBMASTER_RENDER_DAYS=35
WEBMASTER_RENDER_REFRESH_SECONDS=60.0

YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_WEBMASTER_OAUTH_TOKEN=
# Персайтные OAuth-токены Вебмастера (ЧТЗ_Вебмастер_Персайтные_токены):
# сайты верифицируются в разных аккаунтах Яндекса → токен на сайт.
# JSON {"<домен>": "<токен>"}; домен — как в sites.yml (unicode для IDN).
# YANDEX_WEBMASTER_OAUTH_TOKEN — общий fallback для доменов без записи.
# НИКОГДА не коммитить!
YANDEX_WEBMASTER_OAUTH_TOKENS={}

# ЭПИК-9: ключи доступа к эндпоинтам метрик сайтов (ADR-007/ADR-010).
# SITE_METRICS_API_KEY — общий fallback (сайты без персонального ключа);
# SITE_METRICS_API_KEYS — JSON с персональными ключами: {"<домен>": "<ключ>"}.
# Домен — как в config/sites.yml (unicode для IDN). НИКОГДА не коммитить!
SITE_METRICS_API_KEY=
SITE_METRICS_API_KEYS={}

# ЭПИК-7: алерты → Telegram (ADR-006).
# 1) Создать бота: @BotFather → /newbot → получить token
# 2) Написать боту любое сообщение (или /start)
# 3) chat_id: открыть https://api.telegram.org/bot<TOKEN>/getUpdates
#    → result[].message.chat.id (личный чат — положительное число)
# 4) Заполнить ниже и пересоздать: docker compose -p monitoring up -d --force-recreate alertmanager
# Пока пусто — алерты работают (видны на 127.0.0.1:9091/alerts), но в Telegram не уходят.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GRAFANA_ADMIN_PASSWORD=change_me
