# Шаблон секретов и настроек. Копировать в .env (chmod 600). .env НЕ коммитить!

LOG_LEVEL=INFO
LOG_FORMAT=json
SITES_CONFIG_PATH=config/sites.yml

# ЭПИК-1: uptime/SSL-коллекторы
UPTIME_INTERVAL_SECONDS=60
UPTIME_TIMEOUT_SECONDS=10.0
UPTIME_SUCCESS_MAX_CODE=399
SSL_INTERVAL_SECONDS=3600
SSL_TIMEOUT_SECONDS=10.0

# ЭПИК-2: коллектор Яндекс.Метрики (5 минут — см. ADR-003 §3)
METRIKA_INTERVAL_SECONDS=300
METRIKA_TIMEOUT_SECONDS=10.0

# ЭПИК-5: коллектор Яндекс.Вебмастера (host_id сайтов — в config/sites.yml)
WEBMASTER_INTERVAL_SECONDS=3600
WEBMASTER_TIMEOUT_SECONDS=10.0
WEBMASTER_TOP_QUERIES=50

YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_WEBMASTER_OAUTH_TOKEN=

# ЭПИК-9: ключ доступа к эндпоинтам метрик сайтов (ADR-007).
# Совпадает с X-Monitoring-Key в nginx сайтов (для da-dryclean.ru —
# см. ЧТЗ сайта). Генерация: openssl rand -hex 32. НИКОГДА не коммитить!
SITE_METRICS_API_KEY=

# ЭПИК-7: алерты → Telegram (ADR-006).
# 1) Создать бота: @BotFather → /newbot → получить token
# 2) Написать боту любое сообщение (или /start)
# 3) chat_id: открыть https://api.telegram.org/bot<TOKEN>/getUpdates
#    → result[].message.chat.id (личный чат — положительное число)
# 4) Заполнить ниже и пересоздать: docker compose -p monitoring up -d --force-recreate alertmanager
# Пока пусто — алерты работают (видны на 127.0.0.1:9091/alerts), но в Telegram не уходят.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GRAFANA_ADMIN_PASSWORD=change_me
