# Шаблон секретов и настроек. Копировать в .env (chmod 600). .env НЕ коммитить!

LOG_LEVEL=INFO
LOG_FORMAT=json
SITES_CONFIG_PATH=config/sites.yml

# ЭПИК-1: uptime/SSL-коллекторы
UPTIME_INTERVAL_SECONDS=60
UPTIME_TIMEOUT_SECONDS=10.0
UPTIME_SUCCESS_MAX_CODE=399
SSL_INTERVAL_SECONDS=3600
SSL_TIMEOUT_SECONDS=10.0

YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_WEBMASTER_OAUTH_TOKEN=

GRAFANA_ADMIN_PASSWORD=change_me
